{
  "name": "mouse-brain-atlas",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:browser": "node --import tsx --test --test-concurrency=1 tests/*.browser.ts",
    "test:coordinates:browser": "node --import tsx --test tests/coordinate-input.browser.ts",
    "test:scene:browser": "node --import tsx --test tests/scene.browser.ts",
    "test:mobile:browser": "node --import tsx --test tests/mobile.browser.ts",
    "test:theme:browser": "node --import tsx --test tests/theme.browser.ts",
    "test:vasculature:browser": "node --import tsx --test tests/vasculature.browser.ts"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.180.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "~5.9.3",
    "vite": "^7.1.7",
    "tsx": "^4.20.6",
    "@playwright/test": "^1.55.1",
    "@axe-core/playwright": "^4.10.2"
  }
}
